# Safe for frontend (public). NEVER put secrets here.
# Production: the Koyeb backend URL (no trailing slash, no /api suffix). GitHub Actions supplies this from a repo *variable*.
VITE_API_BASE_URL=https://YOUR-APP-YOUR-ORG.koyeb.app
VITE_API_TIMEOUT_MS=15000
# Dev-only mock (ignored by production builds). Keep false when testing against the real backend.
VITE_USE_MOCK_AUTH=false
# Must match APP_DEEP_LINK_SCHEME on the backend and the AndroidManifest intent-filter.
VITE_APP_SCHEME=famgateway
