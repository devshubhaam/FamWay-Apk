# ---- Server ----
NODE_ENV=production
PORT=8000
# Public HTTPS URL of THIS backend on Koyeb (no trailing slash). Used in e-mail links + Google redirect.
API_PUBLIC_URL=https://YOUR-APP-YOUR-ORG.koyeb.app

# ---- MongoDB Atlas ----
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/famgateway?retryWrites=true&w=majority

# ---- CORS / CSRF origin allowlist (comma separated, exact origins) ----
# Capacitor Android WebView origin is https://localhost (capacitor://localhost on iOS).
CORS_ORIGINS=https://localhost,capacitor://localhost
# Web build of the app (used for Google redirect on web + extra CORS origin). Optional for APK-only.
WEB_APP_URL=
# Custom URL scheme registered in the Android manifest (see docs). Used to return from Google sign-in.
APP_DEEP_LINK_SCHEME=famgateway

# ---- Session ----
SESSION_TTL_DAYS=30

# ---- E-mail (SMTP) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="FamGateway <no-reply@example.com>"

# ---- Google OAuth (client secret stays HERE, never in the app) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must exactly match an "Authorized redirect URI" in Google Cloud: <API_PUBLIC_URL>/auth/google/callback
GOOGLE_REDIRECT_URI=https://YOUR-APP-YOUR-ORG.koyeb.app/auth/google/callback

# ---- Passkeys (WebAuthn) ----
# RP ID = registrable domain of the backend host, NO scheme/port. Prod example: your-app-your-org.koyeb.app
PASSKEY_RP_ID=YOUR-APP-YOUR-ORG.koyeb.app
PASSKEY_RP_NAME=FamGateway
# Web origins allowed to use passkeys (comma separated, with scheme). Usually the backend origin + web app origin.
PASSKEY_ORIGINS=https://YOUR-APP-YOUR-ORG.koyeb.app
# Android app origin(s): "android:apk-key-hash:" + base64url(SHA-256 of signing cert). Comma separated.
PASSKEY_ANDROID_ORIGINS=
# For /.well-known/assetlinks.json (Digital Asset Links)
ANDROID_PACKAGE_NAME=com.example.paymentdashboard
ANDROID_CERT_SHA256=AA:BB:CC:...
